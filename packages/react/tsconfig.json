{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "composite": true
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../core" }]
}
