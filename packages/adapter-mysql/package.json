{
  "name": "@fae/adapter-mysql",
  "version": "0.1.0",
  "description": "MySQL adapter for FAE — implements UserDataProvider and UserRepository",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fae/core": "*",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
